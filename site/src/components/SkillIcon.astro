---
import bootstrap from '../../../skills/c4-bootstrap/assets/icon.svg?url';
import c4 from '../../../skills/c4/assets/icon.svg?url';
import resolve from '../../../skills/c4-resolve/assets/icon.svg?url';
import drift_report from '../../../skills/c4-drift-report/assets/icon.svg?url';
import review from '../../../skills/c4-review/assets/icon.svg?url';
import review_loop from '../../../skills/c4-review-loop/assets/icon.svg?url';

const icons = { bootstrap, c4, resolve, drift_report, review, review_loop };

interface Props {
  skill: keyof typeof icons;
}

const { skill } = Astro.props;
---

<span class="skill-icon" aria-hidden="true">
  <img src={icons[skill]} width="28" height="28" alt="" />
</span>

<style>
  .skill-icon {
    display: inline-grid;
    place-items: center;
    flex: none;
    inline-size: 40px;
    block-size: 40px;
    border-radius: 50%;
    background: light-dark(
      var(--md-sys-color-surface-container),
      var(--md-sys-color-surface-container-low)
    );
  }

  img {
    display: block;
    inline-size: 28px;
    block-size: 28px;
  }
</style>
