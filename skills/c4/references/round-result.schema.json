{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "c4 round result",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "outcome", "files_written", "questions",
               "frontier_empty", "contradictions", "new_tasks", "summary"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^T\\d{2,}$"},
    "outcome": {"enum": ["complete", "needs_user", "blocked"]},
    "files_written": {"type": "array", "items": {"type": "string"}},
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "question", "recommendation", "decision"],
        "properties": {
          "number": {"type": "integer"},
          "question": {"type": "string"},
          "recommendation": {"type": "string"},
          "decision": {"type": "string"}
        }
      }
    },
    "frontier_empty": {"type": "boolean"},
    "contradictions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document", "statement", "evidence"],
        "properties": {
          "document": {"type": "string"},
          "statement": {"type": "string"},
          "evidence": {"type": "string"}
        }
      }
    },
    "new_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope", "task", "depends_on", "reason"],
        "properties": {
          "scope": {"type": "string"},
          "task": {"type": "string"},
          "depends_on": {"type": "array", "items": {"type": "string"}},
          "reason": {"type": "string"}
        }
      }
    },
    "summary": {"type": "string"}
  }
}
